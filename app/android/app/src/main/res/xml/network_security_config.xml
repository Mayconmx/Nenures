<?xml version="1.0" encoding="utf-8"?>
<!-- Release: só conexões com TLS, só com autoridades do sistema (sem fixação de certificado, D14). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
